BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
BreakBeforeBraces: Attach

# Includes are grouped by hand (system / third-party / project) with blank
# lines; clang-format only sorts inside each group.
SortIncludes: CaseSensitive

AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
InsertBraces: true

# Visual rhythm: one blank line between definitions, indented case labels,
# aligned macro bodies and trailing comments.
SeparateDefinitionBlocks: Always
IndentCaseLabels: true
AlignConsecutiveMacros: Consecutive
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 1
InsertNewlineAtEOF: true
MaxEmptyLinesToKeep: 1

BinPackArguments: false
BinPackParameters: OnePerLine
PointerAlignment: Right
